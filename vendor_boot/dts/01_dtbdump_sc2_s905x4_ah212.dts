		phandle = <0x99>;
	};

	hifidsp0 {
		compatible = "amlogic, hifidsp0";
		status = "okay";
		startup-position = [01];
		memory-region = <0x18>;
		reg-names = "base-reg\0device-support-reg\0ddrfw-region";
		reg = <0x00 0xfe340000 0x00 0x114 0x00 0xfe44006c 0x00 0x04 0x00 0x00 0x00 0x800000>;
		clocks = <0x09 0x5d>;
		clock-names = "dspa_clk";
		pm-support = [00];
		dsp-support-bit = <0x1000000>;
		power-domains = <0x19 0x00>;
		mboxes = <0x12 0x03 0x12 0x01>;
		clkfreq-khz = "\0\f5";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		apb4@fe000000 {
			compatible = "simple-bus";
			reg = <0x00 0xfe000000 0x00 0x480000>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges = <0x00 0x00 0x00 0xfe000000 0x00 0x480000>;

			clock-controller {
				compatible = "amlogic,sc2-clkc";
				#clock-cells = <0x01>;
				reg = <0x00 0x00 0x00 0x49c 0x00 0x8000 0x00 0x2e8 0x00 0xe140 0x00 0x24>;
				reg-names = "basic\0pll\0cpu_clk";
				clocks = <0x17>;
				clock-names = "xtal";
				status = "okay";
				phandle = <0x09>;
			};

			meson_clk_msr@48000 {
				compatible = "amlogic,meson-sc2-clk-measure";
				reg = <0x00 0x48000 0x00 0x1c>;
