		#io-channel-cells = <0x01>;
		clocks = <0x17 0x09 0x138 0x09 0x106 0x09 0x104>;
		clock-names = "clkin\0core\0adc_clk\0adc_sel";
		interrupts = <0x00 0xb5 0x01>;
